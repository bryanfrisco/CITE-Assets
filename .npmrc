# React Native's Metro bundler resolves modules by walking node_modules
# upwards, and it does not understand pnpm's symlinked store. Hoisting puts a
# flat tree back where Metro expects it.
#
# This is the reason the project can leave npm at all: with a real lockfile,
# `scripts/eas-build-pre-install.mjs` — which deleted package-lock.json on the
# builder so npm would re-resolve platform-conditional optional dependencies —
# is no longer needed, and builds become reproducible again.
node-linker=hoisted
shamefully-hoist=true
